@using System.Collections;
@using Web_Sorteo_Agencias.Config;
@{
	ViewData["Title"] = "Inicio";

	Repositorio _repos = new Repositorio();
	string FechaInicio = _repos.fechaInicial;
	string FechaFin = _repos.fechaFinal;
}

<div class="text-center">
	<p class="h2 mb-3" style="color:#09467C">SORTEO OFICINAS @DateTime.Now.Year</p>
	<div class="container">
		<div class="row justify-content-center d-flex mb-3">
			<div class="col-lg-4 col-md-8">
				@Html.DropDownList("sucursales", null, new
					{
						@class = "form-select",
						id = "sucursalesDropdown",
						@onchange = "sucursalSeleccionada(this.value)"
					})
			</div>
		</div>

		<div class="row">
			<div class="col-md-7 col-sm-12 mb-2 p-1">
				<div class="card h-100">
					<div class="card-body d-grid justify-content-center align-content-center text-center align-items-center">

						<p class="m-0 p-0">
							<i id="spinner" style="display:none" class="fas fa-spinner fa-spin fa-lg"></i>
						</p>

						<h1 id="nombreSucursal" class="fw-bold" style="color:#09467C">
							@if (ViewBag.sucursal is not null)
							{
								@ViewBag.sucursal.DESCRIPCION
							}
						</h1>
						<h1 id="numeroSocios" style="color:#09467C">
							@if (ViewBag.sucursal is not null)
							{
								@ViewBag.sucursal.NUMERO
							}

						</h1>
						@if (ViewBag.sucursal is not null)
						{
							<p id="fechas">
								SOCIOS A PARTICIPAR
							</p>
						}
						else
						{
							<p id="fechas" style="display:none;">
								SOCIOS A PARTICIPAR
							</p>
						}


						<div class="d-grid gap-2 mx-auto">
							<div id="btn-funcion" style="display:none">
								<button onclick="BuscarSocio()" class="btn btn-success px-4 btn-lg rounded-pill">Aceptar</button><br>
							</div>
							<div id="btn-funcionFin" style="display:none">
								<input id="ganSucural" hidden />
								<button onclick="DefinirGanador()" class="btn btn-primary px-4 rounded-pill">Finalizar</button><br>
							</div>
						</div>


						<div class="d-grid gap-2 mx-auto">
							<div id="card-ganador" style="display:none; max-width: 25rem; width: 30rem;" class="card mb-3 shadow">
								<div class="card-header bg-success text-white h3">Ganador</div>
								<div class="card-body">
									<h5 id="nombreGanador" style="color:#09467C" class="card-title"></h5>
									<p class="m-0 p-0" id="cedulaGanador"></p>
									<p class="m-0 p-0" id="numeroGanador"></p>
								</div>
							</div>
						</div>

						@if (ViewBag.sucursal is null)
						{
							<p id="msg-init" class="text-secondary h2">Seleccione una agencia</p>
						}
					</div>
				</div>
			</div>
			<div class="col-md-5 col-sm-12 mb-2 p-1">
				<div class="card h-100">
					<div class="card-header" style="color:#09467C">Socios seleccionados</div>
					<div class="card-body table-responsive">
						<i id="spinnerTabla" style="font-size:50px;display:none" class="fas fa-spinner fa-spin fa-lg text-success"></i>
						<table class="table small" id="tablaSocios" style="display:none">
							<thead>
								<tr style="color:#09467C">
									<th>Socio</th>
									<th>Cedula</th>
									<th>N° Socio</th>
									<th width="120"></th>
								</tr>
							</thead>
							<tbody style="font-size:14px;">
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<script>

	function sucursalSeleccionada(val) {
		$("#spinner").show();
		$("#msg-init").hide();
		$("#nombreSucursal").empty();
		$("#numeroSocios").empty();
		$("#fechas").hide();
		$("#btn-funcion").hide();
		$("#card-ganador").hide();
		$("#tablaSocios").hide();
		const valores = val.split("-")
		$.ajax({
			url: "@Url.Action("sucursalSelected", "Home")",
			type: "post",
			data: { codigo: valores[0], tipo: valores[1] },
			traditional: true,
			success: function (response) {
				//console.log('1',response)
				$("#spinner").hide();
				$("#nombreSucursal").append(response.sucursal.descripcion.toUpperCase());
				$("#numeroSocios").append(response.sucursal.numero);
				$("#fechas").show();
				$("#btn-funcion").show();
				document.getElementById("tablaSocios").querySelector("tbody").innerHTML = "";

				if (response.sociosRegistrados.length > 0) {
					PintarDatosTabla(response.sociosRegistrados);
				}
			}
		});
	}

	function BuscarSocio() {
		var codigosuc = $('#sucursalesDropdown').val();
		var valores = codigosuc.split("-")
		if (valores[0] == 0) return;
		$("#tablaSocios").hide();
		$("#spinnerTabla").show();
		$.ajax({
			url: "@Url.Action("seleccionAleatoria", "Home")",
			type: "post",
			data: { codigo: valores[0], tipo:valores[1] },
			traditional: true,
			success: function (response) {
				//console.log('2',response);
				$("#spinnerTabla").hide();
				PintarDatosTabla(response);
				$("#btn-funcionFin").show();
				$("#ganSucural").val(response[response.length - 1].numeroSocio);
			}
		});
	}

	function PintarDatosTabla(listaSocios) {
		//console.log('3',listaSocios)
		document.getElementById("tablaSocios").querySelector("tbody").innerHTML = "";
		$.each(listaSocios, function (index, socio) {
			//console.log('4',socio)
			var fila = $('<tr>').append(
				$('<td>').text(socio.nombreSocio),
				$('<td>').text(Mascara(socio.cedula)),
				$('<td>').text(Mascara(socio.numeroSocio)),
				$('<td>').text(socio.detalle),
			);
			if (socio.estado === 'Ganador') {
				fila.addClass('text-success h6');
			}
			$('#tablaSocios tbody').append(fila);
		});
		$("#tablaSocios").show();
		var socioga = listaSocios.find(x => x.estado === 'Ganador');
		if (socioga != undefined) {
			//Deshabilitar botón de selección
			$("#btn-funcion").hide();

			//Mostrar ganador en caso e haberlo
			$("#card-ganador").show();
			$("#nombreGanador").empty();
			$("#nombreGanador").append(socioga.nombreSocio);
			$("#cedulaGanador").empty();
			$("#cedulaGanador").append('Cédula: ' + Mascara(socioga.cedula));
			$("#numeroGanador").empty();
			$("#numeroGanador").append('Número socio: ' + Mascara(socioga.numeroSocio));
		}
	}

	function DefinirGanador() {
		$("#btn-funcion").hide();
		$("#btn-funcionFin").hide();
		var codigosuc = $('#sucursalesDropdown').val();
		var valores = codigosuc.split("-")
		var numClienteGanador = $('#ganSucural').val();
		if (valores[0] == 0) return;
		$.ajax({
			url: "@Url.Action("guardarGanador", "Home")",
			type: "post",
			data: { codigo: valores[0], numclgan: numClienteGanador, tipo: valores[1] },
			traditional: true,
			success: function (response) {
				//console.log('ok',response);
				if (response.length > 0) {
					PintarDatosTabla(response);
				}
			}
		});
	}

	function Mascara(texto){
		if (!texto || texto.length <= 4) {
			return 'X'.repeat(texto.length);
		}

		const start = texto.slice(0, -4);
		const xPart = 'X'.repeat(4);
		return start + xPart;
	}
</script>